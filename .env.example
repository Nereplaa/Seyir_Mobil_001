# Bu dosya GitHub'a GİDER (gerçek .env gitmez) - sadece hangi değişkenlerin gerektiğini
# gösteren bir şablon. Gerçek çalışan değerler icin bu dosyayı ".env" olarak kopyalayıp
# kendi rastgele değerlerini yaz (docker compose aynı klasördeki .env'i otomatik okur).
#
# Rastgele güçlü bir değer üretmek için (Git Bash / WSL):
#   openssl rand -base64 48        (JWT_SECRET_KEY icin)
#   openssl rand -hex 32           (GRAYLOG_PASSWORD_SECRET icin)
#
# GRAYLOG_ROOT_PASSWORD_SHA2, sifrenin kendisi DEGIL, SHA-256 hash'i olmali:
#   echo -n "sifreniz" | openssl dgst -sha256

SQL_SA_PASSWORD=
GRAYLOG_PASSWORD_SECRET=
GRAYLOG_ROOT_PASSWORD_SHA2=
JWT_SECRET_KEY=

# "Sifremi Unuttum" maili icin SMTP (gelistirmede Mailtrap gibi bir test servisi onerilir -
# gercek kullaniciya mail GITMEZ, kendi test kutunda gorursun). Bos birakilirsa mail
# gonderilmez ama uygulama COKMEZ (bkz. Services/MailService.cs) - sadece log'a "Smtp:Host
# yapilandirilmamis" yazar.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
